# Codexa Environment Variables Configuration Example

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Ingestion & Staging Limits
CODEXA_MAX_COMPRESSED_SIZE_MB=25
CODEXA_MAX_EXTRACTED_SIZE_MB=100
CODEXA_MAX_FILE_COUNT=1000
CODEXA_MAX_PATH_DEPTH=15
CODEXA_MAX_SINGLE_FILE_SIZE_MB=5
CODEXA_STAGING_DIR=.staging

# AI / LLM Configuration (Optional - deterministic fallback active if unset)
CODEXA_AI_ENABLED=false
CODEXA_AI_PROVIDER=none
CODEXA_AI_API_KEY=
CODEXA_AI_MODEL=gemini-1.5-pro
CODEXA_AI_TIMEOUT_MS=15000

# Persistence (Optional - H2 in-memory default if unset)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codexa
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
