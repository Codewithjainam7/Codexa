# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,json,yml,yaml,css,html,md}]
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[Makefile]
indent_style = tab
